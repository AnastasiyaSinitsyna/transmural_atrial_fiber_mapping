imp_region[0].num_IDs = 0
imp_region[0].ID = 11
imp_region[0].im_param = "GNa*1.0,Gto*1.0,GKr*1.0,GCaL*1.0,GK1*1.0,factorGKur*1.0" 

#LAA
imp_region[1].im = Courtemanche
