imp_region[1].ID  = 13
imp_region[1].im_param = "GNa*1.0,Gto*1.0,GKr*1.0,GCaL*1.0,GK1*1.0,factorGKur*1.0" 

#PV
imp_region[2].im = Courtemanche
imp_region[2].num_IDs  = 4
imp_region[2].ID  = 21, 23, 25, 27
imp_region[2].im_param = "GNa*1.0,Gto*1.0,GKr*1.0,GCaL*1.0,GK1*1.0,factorGKur*1.0" 
 

#Conductivity values/Tissue properties
