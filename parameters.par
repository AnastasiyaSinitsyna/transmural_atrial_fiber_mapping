phys_region[0].num_IDs   = 6
phys_region[0].ID        = 11 13 21 23 25 27 

dt                       = 20
timedt                   = 1
spacedt                  = 10
sentinel_ID              = 0
tend                     = 2500
experiment               = 0
parab_solve              = 1
mass_lumping             = 0
bidomain                 = 0
bidm_eqv_mono            = 0
